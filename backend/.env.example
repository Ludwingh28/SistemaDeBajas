# Puerto del servidor
PORT=3001

# Entorno (development | production)
NODE_ENV=development

# Códigos de supervisores (hasheados con bcrypt)
# Usa el script generateHash.js para crear nuevos códigos
SUPERVISOR_CODES=

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Configuración de archivos
MAX_FILE_SIZE=5242880
MAX_FILES=5

# Paths de Excel (relativos a /data)
EXCEL_CLIENTES=clientes.xlsx
EXCEL_RUTAS=rutas.xlsx
MOTIVOS_FILE=motivos.txt

# Cache TTL (en segundos)
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=sistema_bajas

# Google Sheets Configuration - Planificación por Regionales
# URLs de las 3 hojas del mismo Google Sheet (una por regional)
#
# Puedes usar DOS TIPOS de URL:
#
# OPCIÓN 1 - Compartir (con gid):
#   1. Haz clic en "Compartir" → "Cualquiera con el enlace puede ver"
#   2. Haz clic en cada pestaña de hoja y copia la URL completa con #gid=123456
#   Ejemplo: https://docs.google.com/spreadsheets/d/1ABC123.../edit#gid=0
#
# OPCIÓN 2 - Publicar en la web como CSV (recomendado si no ves gid):
#   1. Archivo → Compartir → Publicar en la web
#   2. Selecciona la hoja específica que deseas publicar
#   3. Formato: CSV
#   4. Copia la URL generada
#   Ejemplo: https://docs.google.com/spreadsheets/d/e/2PACX-1vT.../pub?gid=123&single=true&output=csv
#
# NOTA: El sistema leerá TODAS las zonas que aparezcan en cada hoja, sin filtros

# Hoja 1: Regional Santa Cruz (incluye todas las zonas de Santa Cruz)
GOOGLE_SHEET_SANTA_CRUZ=

# Hoja 2: Regional Cochabamba (incluye todas las zonas de Cochabamba)
GOOGLE_SHEET_COCHABAMBA=

# Hoja 3: Regional La Paz (incluye todas las zonas de La Paz)
GOOGLE_SHEET_LA_PAZ=